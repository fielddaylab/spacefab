# basePath ResearchIntro

::IntroSelectTrace
@trigger    OnSetupComplete
$if MinigameHasValidSolution()
    {@PAL}  You've already researched everything you need to!
$else
    $set temp:designTutorialStep = 0
    $call   ReleaseAllHighlights()
    $call   HighlightElement(research:sample-copper)
    $call   HighlightElement(research:sample-SiliconDioxide)
    {@PAL}  Start by selecting a sample.
$endif


::OnLiftFromTray
@trigger    OnSampleLifted
@when       source == "tray", !MinigameHasValidSolution()
$call   ReleaseAllHighlights()
//$call   ReleaseHighlight(research:sample-copper)
//$call   ReleaseHighlight(research:sample-SiliconDioxide)
$call   HighlightElement(research:primary-slot)
{@PAL}  Place the sample in the Voltage Chamber.


::OnLiftFromSlot
@trigger    OnSampleLifted
@when       source == "slot", !MinigameHasValidSolution()
$call   ReleaseAllHighlights()
$call   HighlightElement(research:primary-slot)
{@PAL}  Place a sample in the Voltage Chamber.


::OnPlaceIntoSlot
@trigger    OnSlotFilled
@when       slotType == "primary", !MinigameHasValidSolution()
$call   ResetCurrentChamber()
$call   ReleaseAllHighlights()
//$call   ReleaseHighlight(research:primary-slot)
$call   HighlightElement(research:increase-voltage-btn)
$call   AddObsBtn->SetActive(false)
{@PAL}  Now add voltage and observe if anything happens.


::OnVoltageIncreased
@trigger    OnVoltageIncreased
@when       !MinigameHasValidSolution()
$call   ReleaseAllHighlights()
//$call   ReleaseHighlight(research:increase-voltage-btn)
$call   AddObsBtn->SetActive(true)
$call   HighlightElement(research:add-observation-btn)
{@PAL}  Now add your observation.


::OnAddObsClicked
@trigger    OnObservationPickerOpened
@when       !MinigameHasValidSolution()
$call   ReleaseAllHighlights()
//$call   ReleaseHighlight(research:add-observation-btn)
{@PAL}  Choose your observation.


::OnVerifyButtonShown
@trigger    OnVerifyButtonShown
@when       !MinigameHasValidSolution()
$call   ReleaseAllHighlights()
$call   HighlightElement(research:verify-observation-btn)
{@PAL}  Select "Verify" to check if observation matches the selected hypothesis.


::OnHypothesisCorrect
@trigger    OnHypothesisSubmitted
@when       result == "success", !MinigameHasValidSolution()
{@PAL}  Correct.
$wait 2
$call   OpenWikiToLastDiscovery()

::OnLastHypothesisCorrect
@trigger    OnHypothesisSubmitted
@when       result == "success", MinigameHasValidSolution()
$call   HighlightElement(return-button)
{@PAL}  You've completed all research tasks. Press the back button to work on your next game.

::OnHypothesisIncorrectHypothesisMismatch
@trigger    OnHypothesisSubmitted
@when       result == "failure", reason == "hypothesis_mismatch", !MinigameHasValidSolution()
$call ReleaseAllHighlights()
$call HighlightElement(research:left-hypothesis)
$call HighlightElement(research:right-hypothesis)
{@PAL}  Your hypothesis doesn't match the observation. Try changing the hypothesis or select a different observation.

::OnHypothesisIncorrectObservationError
@trigger    OnHypothesisSubmitted
@when       result == "failure", reason == "observation_incorrect", !MinigameHasValidSolution()
{@PAL}  The observation is incorrect. Try a different observation or select another sample.

::OnWikiClosed
@trigger    OnWikiClosed
@when       !MinigameHasValidSolution()
{@PAL}      Now see if you can find a sample that satisfies the other hypothesis.
