# basePath DesignIntro2

::IntroSelectTrace
@trigger    OnDesignSetupComplete
@when       CurrLevelIndex() == 1
$if IsLevelSolved(1) == true
    $set temp:designTutorialStep = 4
    {@PAL}  If you modify your grid, you'll need to re-rerun all tests.
$else
    $set temp:designTutorialStep = 0
    $call   HighlightElement(design:metal-tool-btn)
    $call   HighlightElement(design:input-b, false, 25)
    $call   HighlightElement(design:output-y, false, 25)
    {@PAL} Now there are 2 inputs and 2 outputs.\n\nDraw the connection from B to Y.
$endif


::ToolSelected
@trigger    OnToolSelected
@when       tool == "DrawMetal", CurrLevelIndex() == 1, temp:designTutorialStep == 0
$set    temp:designTutorialStep = 1
$call   ReleaseHighlight(design:metal-tool-btn)


::CompleteConnection
@trigger    OnDragReleased
@when       CurrLevelIndex() == 1, IsInputConnectedToAnyOutput("B") == true, temp:designTutorialStep == 1
$if IsInputConnectedToOutput("B", "Y") == true
    // player made the correct connection
    $set    temp:designTutorialStep = 2
    $call   ReleaseAllHighlights()
    $call   HighlightElement(design:test-btn)
    {@PAL}  Run a test with A and B both set to LO.
$else
    // player made incorrect connection
    {@PAL}  This line is incorrect. Make sure Input B is fully connected with Output Y.
$endif


::FirstTestCorrect
@trigger    OnSingleTestComplete
@when       result == "success", CurrLevelIndex() == 1, temp:designTutorialStep == 2
$set    temp:designTutorialStep = 3
$call   ReleaseAllHighlights()
$call   HighlightElement(design:input-a, false, 25)
$if     IsInputInState("A", "LO")
    {@PAL}  Correct! Now click the toggle on A to switch it to HI. Then run the new test.
$else
    {@PAL}  Correct! Now click the toggle on A to switch it to LO. Then run the new test.
$endif


::InputSwitch
@trigger    OnInputToggled
@when       CurrLevelIndex() == 1, temp:designTutorialStep == 3
$call   ReleaseHighlight(design:input-a)
$call   HighlightElement(design:test-btn)
$set temp:designTutorialStep = 4


::SecondTestCorrect
@trigger    OnSingleTestComplete
@when       result == "success", CurrLevelIndex() == 1, temp:designTutorialStep == 4
$set    temp:designTutorialStep = 5
$call   ReleaseAllHighlights()
{@PAL}  Correct. Now test the rest of the cases.


::AllTestsCorrect
@trigger    OnAllTestsComplete
@when       CurrLevelIndex() == 1, temp:designTutorialStep == 5
$call   ReleaseHighlight(design:input-a)
{@PAL}  It looks like all test cases passed!
$set    temp:designTutorialStep = 5