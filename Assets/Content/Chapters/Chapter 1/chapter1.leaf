//#region - After Supply Chain 

::AfterSupplyChainCh1
@trigger    OnOverarchingLoaded
@when       IsSolutionFoundFor(Design), IsSolutionFoundFor(Research), IsSolutionFoundFor(Supply)
@cutscene
@once

{@PAL}      The conductor materials just arrived. Quinn is quite efficient!...For a human. 
{@PAL} 		Are you ready to work with our incredible new automation unit? You will have to keep up!
{@Player}   Um... I think so. I used to work with Arken at the Fab, so I know what to expect. 
{@PAL}     	OOOh, this will be soooo much faster than your human teammate. 
{@Player}  	We'll see...

