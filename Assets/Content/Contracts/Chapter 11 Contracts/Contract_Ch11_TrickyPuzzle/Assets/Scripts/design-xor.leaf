# basePath DesignXOR
// XOR

::Intro
@trigger    OnDesignSetupComplete
$set temp:hintGiven = 0
{@PAL} This tricky Logic Gate outputs HI if A and B are different. You may need 6 transistors!

::Hints
@trigger    OnSingleTestComplete
@when       result == "failure"
$if temp:hintGiven == 0
    {@PAL}  <color=yellow>Hint:</color>  If A and B are HI, or A and B are LO, send LO. You can use transistors with two Gates.
    $set temp:hintGiven = 1
$elseif temp:hintGiven == 1
    {@PAL}  <color=yellow>Hint:</color> You can use two transistors for each HI output.
    $set temp:hintGiven = 2
$elseif temp:hintGiven == 2
    {@PAL}  <color=yellow>Hint:</color> Use A and B to control Gates. Use constants to send signals to X.
    $set temp:hintGiven = 0
$endif