# basePath ResearchIntroCh3

::IntroSelectTrace
@trigger    OnSetupComplete
$if MinigameHasValidSolution()
    {@PAL}  You've already researched everything you need to! You can continue your experiments to uncover new insights.
$else
    $call   LockChamber("Doping")
    {@PAL}  You will use both a P-Type and an N-Type dopant to tune your semiconductor to make it useful in your chip.
    $call   UnlockChamber("Doping")
    $call   HighlightElement(research:doping-chamber-btn, false, -1, true)
$endif


::OnDopingChamberSelected
@trigger    OnChamberSwitched
@when       !MinigameHasValidSolution()
$call   ReleaseAllHighlights()
$if     research:chamberId == "Doping"
    $call   CloseWiki()
    $call   ResetCurrentChamber()
    $call   HighlightElement(research:primary-slot)
    {@PAL}  Your Doping Chamber is unlocked.\n\nAdd your semiconductor to this slot.
$endif


::OnSubstrateFilled
@trigger    OnSlotFilled
@when       !MinigameHasValidSolution(), research:chamberId == "Doping", slotType == "primary", research:primaryMaterial == "Silicon"
$call   ReleaseHighlight(research:primary-slot)
$call   HighlightElement(research:secondary-slot)
$call   CloseWiki()
{@PAL}  Place a sample with one more or one less electrons than the available holes.


::OnSubstrateExploded
@trigger    OnMaterialExploded
@when   !MinigameHasValidSolution(), explosionStyle == "InvalidSubstrate"
$call   CloseWiki()
$call   ReleaseHighlight(research:secondary-slot)
$call   HighlightElement(research:primary-slot)
{@PAL}  That is not a confirmed semiconductor.


::OnDopantFilled
@trigger    OnSlotFilled
@when       !MinigameHasValidSolution(), research:chamberId == "Doping", slotType == "secondary"
$call   CloseWiki()
$call   ReleaseHighlight(research:secondary-slot)
$if     research:secondaryMaterial == "Boron" // P type
    {@PAL}  Great! Now add Observations and select a Property to verify.
$elseif research:secondaryMaterial == "Phosphorus" // N type
    {@PAL}  Great! Now add Observations and select a Property to verify.
$endif

::OnDopantExploded
@trigger    OnMaterialExploded
@when   !MinigameHasValidSolution(), explosionStyle == "InvalidCombo"
$call   CloseWiki()
{@PAL}  That sample doesn't fit!\n\nChoose a sample with one more or one less electrons than the available holes.


::OnHypothesisCorrect
@trigger    OnHypothesisSubmitted
@when   result == "success"
$call   CloseWiki()
$if MinigameHasValidSolution()
    {@PAL}  Great. Let's return to the ship.
$elseif research:propertyId == "NDopantFor"
    {@PAL}  Correct. Now see if you can find the other dopant.
$elseif research:propertyId == "PDopantFor"
    {@PAL}  Correct. Now see if you can find the other dopant.
$endif


::OnHypothesisIncorrectHypothesisMismatch
@trigger    OnHypothesisSubmitted
@when       result == "failure", reason == "hypothesis_mismatch"
$call   ReleaseAllHighlights()
$call   CloseWiki()
{@PAL}  Your Property was incorrect.\n\nTry again.

::OnHypothesisIncorrectObservationMismatch
@trigger    OnHypothesisSubmitted
@when       result == "failure", reason == "observation_mismatch"
$call   ReleaseAllHighlights()
$call   CloseWiki()
{@PAL}  Your Property was incorrect.\n\nTry again.

::OnHypothesisIncorrectInvalidObservation
@trigger    OnHypothesisSubmitted
@when       result == "failure", reason == "invalid_observation"
$call   ReleaseAllHighlights()
$call   CloseWiki()
{@PAL}  One or more of your Observations were incorrect. Those are removed.\n\nTry again.