# basePath SupplyIntroCh1

:: StartBuilding
@trigger    OnSupplySetupCompleted
$if     MinigameHasValidSolution()
    $set    temp:researchTutorialStep = -1
$else
    $set    temp:researchTutorialStep = 0
    $call   HighlightElement(supply:ship0)
    $call   CloseWiki()
    {@PAL}  Build a route to complete the contract.\n\nStart by selecting a Hauler.
$endif

:: FirstShipSelected
@trigger    OnShipSelected
@when       temp:researchTutorialStep == 0
$set    temp:researchTutorialStep = 1
$call   ReleaseAllHighlights()
$call   CloseWiki()
{@PAL}  You will need a CONDUCTOR for this contract.\n\nUse the wiki to identify the correct material.
$if     !temp:wikiOpened
    $wait   2
    $call   OpenWikiTo("Materials", "Copper")
    $set    temp:wikiOpened = true
$endif


:: FirstNodeClicked
@trigger    OnNodeClicked
@when       temp:researchTutorialStep == 1
$call   ReleaseAllHighlights()
$call   HighlightElement(supply:home)
$call   CloseWiki()
{@PAL}  Great. Now click your ship.


:: FirstRouteCompleted
@trigger    OnRouteCompleted
@when       temp:researchTutorialStep == 1
$call   ReleaseAllHighlights()
$call   CloseWiki()
$if IsMaterialCollected("Copper")
    $set    temp:researchTutorialStep = 3
    $call   HighlightElement(supply:confirm-btn)
    {@PAL}  Click CONFIRM ROUTES to commit your supply routes.
$else
    $set    temp:researchTutorialStep = 2
    {@PAL}  Uh-oh, this material wasn't a CONDUCTOR.\n\nUse the wiki to identify the correct material.
$endif


:: WikiClosed
@trigger    OnWikiClosed
@when       temp:researchTutorialStep == 2
$call   ReleaseAllHighlights()
$call   HighlightElement(supply:ship0)
{@PAL}  Select the Hauler again to correct the route.


:: OnSecondShipSelected
@trigger    OnShipSelected
@when       temp:researchTutorialStep == 2
$set    temp:researchTutorialStep = 1
$call   ReleaseAllHighlights()
$call   CloseWiki()
{@PAL}  Select the paths to delete the current route, then draw a new path.


:: OnRouteFullyRemoved
@trigger    OnRouteFullyRemoved
$call   ReleaseAllHighlights()
$set    temp:researchTutorialStep = 0
$call   HighlightElement(supply:ship0)
$call   CloseWiki()
{@PAL}  Build a route to complete the contract.\n\nStart by selecting a Hauler.


:: LevelComplete
@trigger    OnRouteCompleted
@when       temp:researchTutorialStep >= 3
$call   ReleaseAllHighlights()
$set    temp:researchTutorialStep = 4
$call   HighlightElement(supply:confirm-btn)
$call   CloseWiki()
{@PAL}  Click CONFIRM ROUTES to commit your supply routes.

:: OnRoutesConfirmed
@trigger    OnRoutesConfirmed
@when   temp:researchTutorialStep >= 3
$call   ReleaseAllHighlights()
{@PAL}  NOW you're ready to start the fabrication.


:: OnShipSelectedAfterLevelComplete
@trigger    OnShipSelected
@when       temp:researchTutorialStep >= 3
$call   ReleaseAllHighlights()
$set    temp:researchTutorialStep = -1