# basePath ResearchIntroCh1

::IntroSelectTrace
@trigger    OnSetupComplete
$if MinigameHasValidSolution()
    {@PAL}  You've already researched everything you need to!
$else
    $call   UnlockWikiPage("Basic Conductor")
    $call   UnlockWikiPage("Basic Insulator")
    $call   LockWikiPage("Conductor") // only Basic Conductor is available in first chapter 
    $call   LockWikiPage("Insulator") // only Basic Insulator is available in first chapter
    {@PAL}  Start by selecting a sample on the left.
$endif


::OnLiftFromTray
@trigger    OnSampleLifted
@when       source == "tray", !MinigameHasValidSolution()
$call   ReleaseAllHighlights()
$call   HighlightElement(research:primary-slot)
{@PAL}  Place the sample in the Voltage Chamber.


::OnLiftFromSlot
@trigger    OnSampleLifted
@when       source == "slot", !MinigameHasValidSolution()
$call   ReleaseAllHighlights()
$call   HighlightElement(research:primary-slot)
{@PAL}  Place a sample in the Voltage Chamber.


::OnPlaceIntoSlot
@trigger    OnSlotFilled
@when       slotType == "primary", !MinigameHasValidSolution()
$call   ResetCurrentChamber()
$call   ReleaseAllHighlights()
$call   HighlightElement(research:increase-voltage-btn)
$call   AddObsBtn->SetActive(false)
{@PAL}  Let's add voltage and observe if anything happens.


::OnVoltageIncreased
@trigger    OnVoltageIncreased
@when       !MinigameHasValidSolution(), research:primaryMaterial != "null"
$call   ReleaseHighlight(research:increase-voltage-btn)
$call   AddObsBtn->SetActive(true)
$call   CloseWiki()
{@PAL}  Now add your observation.

::OnObservationAdded
@trigger    OnObservationAdded
@when       !MinigameHasValidSolution()
$call   CloseWiki()
{@PAL}  Now add a hypothesis property that matches your observation.

::OnVerifyButtonShown
@trigger    OnVerifyButtonShown
@when   !MinigameHasValidSolution()
$call   CloseWiki()
{@PAL}  Select "VERIFY" to check if observation matches the selected hypothesis.


::OnHypothesisCorrect
@trigger    OnHypothesisSubmitted
@when       result == "success"
$call   ReleaseAllHighlights()
$call   CloseWiki()
$if MinigameHasValidSolution()
    $call   HighlightElement(return-button)
    {@PAL}  Correct. You've completed all research tasks! Press "COMPLETE" to return to the ship.
$else
    $call   HighlightElement(research:primary-slot)
    {@PAL}  Correct. Now see if you can find a sample that satisfies the other hypothesis.
$endif
$wait 1
$call   OpenWikiToLastDiscovery()
$wait 1.5
$call   CloseWiki()

::OnHypothesisIncorrectHypothesisMismatch
@trigger    OnHypothesisSubmitted
@when       result == "failure", reason == "hypothesis_mismatch"
$call   ReleaseAllHighlights()
$call   CloseWiki()
{@PAL}  Your hypothesis doesn't match the sample. Try changing the hypothesis.

::OnHypothesisIncorrectObservationMismatch
@trigger    OnHypothesisSubmitted
@when       result == "failure", reason == "observation_mismatch"
$call   ReleaseAllHighlights()
$call   CloseWiki()
{@PAL}  Your hypothesis doesn't match the observation. Try a different observation or select another sample.

::OnHypothesisIncorrectInvalidObservation
@trigger    OnHypothesisSubmitted
@when       result == "failure", reason == "invalid_observation"
$call   ReleaseAllHighlights()
@call   CloseWiki()
{@PAL}  Your observation doesn't match the sample. Try changing the observation.