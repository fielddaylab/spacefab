# basePath DesignIntroCh2

// Level 2: Lower Layer

::IntroSelectTrace
@trigger    OnDesignSetupComplete
@when       CurrLevelIndex() == 0
$if IsLevelSolved(0) == true
    $set temp:designTutorialStep = 5
    {@PAL}  If you modify your grid, you'll need to re-rerun all tests.
$else
    $set temp:designTutorialStep = 0
    $call   HighlightElement(design:n-transistor-tool-btn)
    {@PAL}  There is a layer below the metal layer. Use this semiconductor layer to complete the chip.
$endif


::OnNTransistorToolSelected
@trigger    OnToolSelected
@when       tool == "DrawNNodes", CurrLevelIndex() == 0, temp:designTutorialStep == 0
$set    temp:designTutorialStep = 1
$call   ReleaseAllHighlights()
{@PAL}  Now click and drag to complete a connection between Input A and Output X.


::OnNTransistorDrawn
@trigger    OnDragReleased
@when       CurrLevelIndex() == 0
$call   ReleaseAllHighlights()
$if temp:designTutorialStep == 1
    $set temp:designTutorialStep = 2
    $call   HighlightElement(design:via-tool-btn)
    {@PAL}  Use the Via tool to connect metal and semiconductor in a single cell.
$endif


::OnViaToolSelected
@trigger    OnToolSelected
@when       tool == "DrawVia", CurrLevelIndex() == 0, temp:designTutorialStep == 2
$set    temp:designTutorialStep = 3
$call   ReleaseAllHighlights()


::OnViaPlaced
@trigger    OnClickReleased
@when       CurrLevelIndex() == 0, temp:designTutorialStep == 3
$set    temp:designTutorialStep = 4
{@PAL}  Click <color=yellow>TEST</color> to verify.


::TestIncorrect
@trigger    OnSingleTestComplete
@when       result == "failure", CurrLevelIndex() == 0
$call   ReleaseAllHighlights()
{@PAL}  The test failed.\n\nMake sure the Via touches both metal and semiconductor.


::TestCorrect
@trigger    OnSingleTestComplete
@when       result == "success", CurrLevelIndex() == 0
$call   ReleaseAllHighlights()
$call   HighlightElement(design:input-a, false, 25)
{@PAL}  Correct!\n\nNow flip the switch on the input and click <color=yellow>TEST</color> again.


::AllTestsPassed
@trigger    OnAllTestsComplete
@when       CurrLevelIndex() == 0
$call   ReleaseAllHighlights()
{@PAL}  It looks like all test cases passed!
$set    temp:designTutorialStep = 5



// Level 3: Underpass

::IntroSelectTraceLv2
@trigger    OnDesignSetupComplete
@when       CurrLevelIndex() == 1
$set    temp:hintGiven = 0
$if IsLevelSolved(1) == true
    $set temp:designTutorialStep = 4
    {@PAL}  If you modify your grid, you'll need to re-rerun all tests.
$else
    $set temp:designTutorialStep = 0
    $call   HighlightElement(design:metal-tool-btn)
    {@PAL}  Look at the Verification table. Output Y is always <color=yellow>HI</color>. Input HI is a constant.\n\nConnect them with the metal.
$endif


::OnMetalToolSelected
@trigger    OnToolSelected
@when       CurrLevelIndex() == 1, tool == "DrawMetal", temp:designTutorialStep == 0
$set    temp:designTutorialStep = 1
$call   ReleaseHighlight(design:metal-tool-btn)


::OnToolChangedFromMetal
@trigger    OnToolSelected
@when   CurrLevelIndex() == 1, temp:designTutorialStep == 1, tool != "DrawMetal"
$set    temp:designTutorialStep = 0
$call   HighlightElement(design:metal-tool-btn)


::OnMetalDrawn
@trigger    OnDragReleased
@when   CurrLevelIndex() == 1, temp:designTutorialStep == 1
$set    temp:designTutorialStep = 2
{@PAL}  To connect input A to output X, use a semiconductor to cross under the metal layer.\n\nRemember, the inputs and outputs are on the metal layer.
$call   HighlightElement(design:p-transistor-tool-btn)
$call   HighlightElement(design:via-tool-btn)


::OnPTransistorToolSelected
@trigger    OnToolSelected
@when   CurrLevelIndex() == 1, temp:designTutorialStep == 2, tool == "DrawPNodes"
$set    temp:designTutorialStep = 3
$call   ReleaseHighlight(design:p-transistor-tool-btn)


::TestCorrectLv2
@trigger    OnSingleTestComplete
@when       result == "success"
$call   ReleaseAllHighlights()
$call   HighlightElement(design:input-a, false, 25)
$if     IsInputInState("A", "LO")
    {@PAL}  Correct!\n\nNow flip the switch on the input to change it from LO to HI.
$else
    {@PAL}  Correct!\n\nNow flip the switch on the input to change it from HI to LO.
$endif


::TestIncorrectLv2
@trigger    OnSingleTestComplete
@when       result == "failure", CurrLevelIndex() == 1
$call   ReleaseHighlight(design:test-btn)
$if temp:hintGiven == 0
    {@PAL}  <color=yellow>Hint:</color> The inputs and outputs are on the metal layer, so you'll need vias to connect the two layers.
    $set temp:hintGiven = 1
$elseif temp:hintGiven == 1
    {@PAL}  <color=yellow>Hint:</color> The paths should cross on different layers.
        $set temp:hintGiven = 2
$elseif temp:hintGiven == 2
    {@PAL}  <color=yellow>Hint:</color> Make sure the Via touches both metal and semiconductor.
    $set temp:hintGiven = 3
$elseif temp:hintGiven == 3
    {@PAL}  <color=yellow>Hint:</color> Constant HI must be connected to output Y.
    $set temp:hintGiven = 0
$endif