# basePath ResearchIntroCh2

::IntroSelectTrace
@trigger    OnSetupComplete
$if MinigameHasValidSolution()
    {@PAL}  You've already researched everything you need to!
$else
    $call   LockChamber("Thermal")
    $set    temp:needsToOpenWiki = true
    {@PAL}  This contract specifies that we need to research a semiconductor. \n\nLet's open up the database!
    $wait   1
    $call   OpenWikiTo("Properties", "Semiconductor")
$endif


::OnSlotFilled // ensures that the player opens the semiconductor page before running the tests
@trigger    OnSlotFilled
@when   !MinigameHasValidSolution(), temp:needsToOpenWiki
$call   CloseWiki()


::OnWikiClosed
@trigger    OnWikiClosed
@when       !MinigameHasValidSolution(), temp:needsToOpenWiki
$call   ReleaseAllHighlights()
$set    temp:needsToOpenWiki = false
{@PAL}  Interesting. Semiconductors don't allow current to pass, and current increases when heat is applied.\n\nTry testing the unknown sample.


::OnVoltageIncreased
@trigger    OnVoltageIncreased
@when       !MinigameHasValidSolution(), research:primaryMaterial == "Silicon"
{@PAL}      It looks like this sample does not allow voltage to pass. Let's record the observation.


::OnNonconductiveSelected
@trigger    research:primaryMaterial == "Silicon", observationId == "nonconductive"
$call   UnlockChamber("Thermal")
$call   ReleaseAllHighlights()
$call   HighlightElement(research:thermal-chamber-btn, false, -1, true)
$call   CloseWiki()
{@PAL}  We have a new chamber! Use the thermal chamber to heat up the samples and see if they change!


// Thermal Observation
::OnThermalChamberSelected
@trigger    OnChamberSwitched
@when       !MinigameHasValidSolution(), research:chamberId == "Thermal"
$call   ReleaseAllHighlights()
$call   HighlightElement(research:increase-heat-btn)
{@PAL}  You’ll need to increase the heat of the chamber to see how it effects the electrical current of the sample.

::OnHeatIncreased
@trigger    OnHeatIncreased
@when   !MinigameHasValidSolution(), research:primaryMaterial == "Silicon"
$call   ReleaseHighlight(research:increase-heat-btn)
{@PAL}  That looks like increased current to me! Use your database to submit your observation.

::OnHeatActivatedSelected
@trigger    OnObservationAdded
@when       !MinigameHasValidSolution(), research:primaryMaterial == "Silicon", observationId == "heatactivated"
$call       CloseWiki()
{@PAL}      Now select the property and verify if your observations match.


::OnVerifyButtonShown
@trigger    OnVerifyButtonShown
@when   !MinigameHasValidSolution(), research:primaryMaterial == "Silicon"
$call   CloseWiki()
{@PAL}  Let's check if your observation matches the selected hypothesis.

::OnHypothesisCorrect
@trigger    OnHypothesisSubmitted
@when   !MinigameHasValidSolution(), result == "success"
$call   CloseWiki()
$if MinigameHasValidSolution()
    {@PAL}  Great. You've completed all research tasks! Let's return to the ship.
$elseif research:primaryMaterial == "Silicon"
    {@PAL}  Great. You've found a semiconductor! Now re-test the samples with the thermal chamber to see if our initial identifications were correct.
$else
    {@PAL}  Correct. Now see if you can complete the remaining requirements.
$endif

::OnHypothesisIncorrect
@trigger    OnHypothesisSubmitted
@when   !MinigameHasValidSolution(), result == "failure"
$call   CloseWiki()
$if     research:primaryMaterial == "Silicon"
    {@PAL}  That doesn't seem right. Remember that semiconductors don't allow current to pass, and current increases when heat is applied.
$else
    {@PAL}  That doesn't seem right. Try changing the hypothesis or select a different observation.
$endif