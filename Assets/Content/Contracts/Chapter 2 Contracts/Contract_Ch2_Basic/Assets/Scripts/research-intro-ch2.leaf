# basePath ResearchIntroCh2

::IntroSelectTrace
@trigger    OnSetupComplete
$if MinigameHasValidSolution()
    {@PAL}  You've already researched everything you need to!
$else
    {@PAL}  You now have access to the Thermal Chamber.\n\nIt shows how a material's properties change when heated.
    $call   HighlightElement(research:thermal-chamber-btn, false, -1, true)
$endif


// Thermal Chamber
::OnThermalChamberSelected
@trigger    OnChamberSwitched
@when       !MinigameHasValidSolution()
$call   ReleaseAllHighlights()
$if     research:chamberId == "Thermal"
    $call   HighlightElement(research:increase-heat-btn)
    $set    temp:needsToIncreaseHeat = true
    $call   CloseWiki()
    {@PAL}  Add a sample and increase the temperature to heat up your materials.
$endif


::OnHeatIncreased
@trigger    OnHeatIncreased
@when   !MinigameHasValidSolution(), temp:needsToIncreaseHeat
$call   ReleaseHighlight(research:increase-heat-btn)
$set    temp:needsToIncreaseHeat = false
$call   CloseWiki()
{@PAL}  Now click <color=yellow>ADD OBSERVATION</color>.\n\nThis time you'll add a thermal observation.

::OnMaterialExploded
@trigger    OnMaterialExploded
$call   CloseWiki()
{@PAL}  This material exploded because it can't handle <color=red>HIGH</color> heat.\n\nTry again with less heat.

::OnVerifyButtonShown
@trigger    OnVerifyButtonShown
@when   !MinigameHasValidSolution()
$call   CloseWiki()
{@PAL}  Click <color=yellow>VERIFY</color> to check your results.

::OnHypothesisCorrect
@trigger    OnHypothesisSubmitted
@when   result == "success"
$call   CloseWiki()
$call   ReleaseAllHighlights()
$if MinigameHasValidSolution()
    {@PAL}  Great. You've completed all research tasks! Let's return to the ship.
$elseif research:primaryMaterial == "Silicon"
    {@PAL}  The Thermal Chamber confirmed that silicon conducts current when heated.\n\nIt's a semiconductor, not an insulator.
$else
    {@PAL}  Correct. Test your other samples.
$endif

::OnHypothesisIncorrectHypothesisMismatch
@trigger    OnHypothesisSubmitted
@when       result == "failure", reason == "hypothesis_mismatch"
$call   ReleaseAllHighlights()
$call   CloseWiki()
{@PAL}  Your Property was incorrect.\n\nTry again.

::OnHypothesisIncorrectObservationMismatch
@trigger    OnHypothesisSubmitted
@when       result == "failure", reason == "observation_mismatch"
$call   ReleaseAllHighlights()
$call   CloseWiki()
{@PAL}  Your Property was incorrect.\n\nTry again.

::OnHypothesisIncorrectInvalidObservation
@trigger    OnHypothesisSubmitted
@when       result == "failure", reason == "invalid_observation"
$call   ReleaseAllHighlights()
$call   CloseWiki()
{@PAL}  One or more of your Observations were incorrect. Those are removed.\n\nTry again.