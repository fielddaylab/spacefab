# basePath ResearchIntroCh2

::IntroSelectTrace
@trigger    OnSetupComplete
$if MinigameHasValidSolution()
    {@PAL}  You've already researched everything you need to!
$else
    $set temp:needsToOpenWikiFirstTime = true
    $call   SetTabById("Material Properties_Tab")
    $call   SetPageById("Semiconductor")
    $call   ShowPrimaryPALButton("OpenProperties")
    {@PAL}  This contract specifies that we need to research a semiconductor. I recommend you open up the ships database to learn properties a semiconductor component has.
$endif


::OnWikiClosed
@trigger    OnWikiClosed
@when       !MinigameHasValidSolution(), temp:needsToOpenWikiFirstTime == true
$set temp:needsToOpenWikiFirstTime = false
{@PAL}      Interesting. Semiconductors don't allow current to pass, and current increases when heat is applied. \n\nI recommend you add a material to the voltage chamber to begin testing.
$call   HighlightElement(research:sample-silicon)

::OnPlaceIntoSlot
@trigger    OnSlotFilled
@when       slotType == "primary", !MinigameHasValidSolution()
$call   ReleaseAllHighlights()
$call   HighlightElement(research:increase-voltage-btn)
{@PAL}      Now apply voltage to to test the sample’s electrical properties


::OnVoltageIncreased
@trigger    OnVoltageIncreased
@when       !MinigameHasValidSolution()
$call   ShowPrimaryPALButton("OpenObservations")
$set    temp:needsToSelectVoltage = true
$set    temp:needsToOpenWikiFirstTime = false // skip OnWikiClosed event and move to OnVoltageObsPageOpened
$if     research:primaryMaterial == "Copper"
    {@PAL}      It looks like this sample allows voltage to pass. Open your database to the Observations tab and click on the observation to record it.
$else
    {@PAL}      It looks like this sample does not allow voltage to pass. Open your database to the Observations tab and click on the observation to record it.
$endif

::OnVoltageObsPageOpened
@trigger    OnWikiPageOpened
@when   temp:needsToSelectVoltage == true, pageId == "Voltage Observations"
$if     research:primaryMaterial == "Copper"
    $call   ReleaseAllHighlights()
    $call   HighlightElement(wiki:observations-electrical-conductive, false, -1, true)
$else
    $call   ReleaseAllHighlights()
    $call   HighlightElement(wiki:observations-electrical-nonconductive, false, -1, true)
$endif

::OnNonVoltageObsPageOpened
@trigger    OnWikiPageOpened
@when   temp:needsToSelectVoltage, pageId != "Voltage Observations"
$call   ReleaseAllHighlights()

::OnAllowsCurrentSelected
@trigger    OnObservationAdded
@when       observationId == "nonconductive"
$call   ReleaseAllHighlights()
$call   HighlightElement(research:thermal-chamber-btn, false, -1, true)
$call   CloseWiki()
$set temp:needsToSelectObs = false 
$set temp:needsToSelectVoltage = false
{@PAL} You’ll need the thermal chamber to add the next observation. Remember to reference the semiconductor component in your database. 


::OnThermalChamberSelected
@trigger    OnChamberSwitched
@when       research:chamberId == "Thermal"
$call   ReleaseAllHighlights()
$call   HighlightElement(research:increase-heat-btn)
{@PAL} Now you’ll need to increase the heat of the chamber to see how it effects the electrical current of the sample.

::OnHeatIncreased
@trigger    OnHeatIncreased
$call   ReleaseAllHighlights()
$call   ShowPrimaryPALButton("OpenObservations")
{@PAL}  That looks like increased current to me! Use your database to submit your observation.
$set temp:needsToSelectThermal = true


::OnFirstObsTabOpened
@trigger    OnWikiTabOpened
@when       temp:needsToSelectThermal
$if local:tabId == "Observations_Tab"
    $call   HighlightElement(wiki:page-thermal-observations, false, -1, true)
$else
    $call   ReleaseAllHighlights()
$endif

::OnThermalObsPageOpened
@trigger    OnWikiPageOpened
@when       temp:needsToSelectThermal, pageId == "Thermal Observations"
$call   ReleaseAllHighlights()
$if     research:primaryMaterial == "Silicon"
    $call   HighlightElement(wiki:observations-thermal-heatactivated, false, -1, true)
$endif

::OnHeatActivatedSelected
@trigger    OnObservationAdded
@when       observationId == "heatactivated"
$call   ReleaseAllHighlights()
$call   CloseWiki()


::OnWikiClosedAfterThermalObs
@trigger    OnWikiClosed
@when       !MinigameHasValidSolution(), temp:needsToSelectThermal == true
$set temp:needsToSelectThermal = false
$call   SetTabById("Material Properties_Tab")
$call   SetPageById("Semiconductor")
$call   ShowPrimaryPALButton("OpenProperties")
$set temp:needsToSelectSemiconductor = true
{@PAL}      Now we need to select a component to verify our observations against.


::OnSemiconductorPageOpened
@trigger    OnWikiPageOpened
@when       temp:needsToSelectSemiconductor == true, pageId == "Semiconductor"
$call   ReleaseAllHighlights()
$call   HighlightElement(wiki:property-semiconductor, false, -1, true)
$set temp:needsToSelectSemiconductor = false


::OnSemiconductorSelected
@trigger    OnPropertyAdded
@when       propertyId == "semiconductor"
$call   ReleaseAllHighlights()
