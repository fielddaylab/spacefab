# basePath  Ch1.Comic

#macro	ComicOpenSpawnPanel(panelIndex, waitDuration) \
	$call ComicSetPanelIndex($panelIndex) \
	$call ComicSpawnMask() \
	$call ComicSpawnLayerIndex(0) \
	$wait $waitDuration

:: Preload
@function   ComicPreload
$call ComicPreloadPage(0)
$call ComicSnapCamera("Camera")

:: Execute
@trigger    ComicExecute
@cutscene

// page 1

$call ComicOpenPage(0)

$ComicOpenSpawnPanel(0, 0.5)
$call ComicNextButton()
$ComicOpenSpawnPanel(1, 0.5)
$call ComicNextButton()
$ComicOpenSpawnPanel(2, 0.5)
$call ComicNextButton()

$ComicOpenSpawnPanel(3, 0.5)
$call ComicNextButton()

$ComicOpenSpawnPanel(4, 0.2)
$ComicOpenSpawnPanel(5, 0.2)
$ComicOpenSpawnPanel(6, 0.2)
$call ComicNextButton()

$call ComicPreloadNextPage()

$ComicOpenSpawnPanel(7, 0.5)
$call ComicNextButton()

// page 2

$call ComicOpenNextPage()
$call ComicPanCameraAsync("Camera", 1)
$wait 0.5

$ComicOpenSpawnPanel(0, 0.5)
$call ComicUnloadPreviousPage()
$ComicOpenSpawnPanel(1, 0.5)
$call ComicNextButton()
$ComicOpenSpawnPanel(2, 0.5)
$ComicOpenSpawnPanel(3, 0.5)
$ComicOpenSpawnPanel(4, 0.5)

$call ComicPreloadNextPage()
$call ComicNextButton()
$ComicOpenSpawnPanel(5, 1)

// page 3

$call ComicOpenNextPage()
$call ComicSnapCamera("Camera")
$call ComicUnloadPreviousPage()
$call ComicPreloadNextPage()

$wait 1
$ComicOpenSpawnPanel(0, 1)
$call ComicNextButton()

// page 4

$call ComicOpenNextPage()
$call ComicSnapCamera("StartCamera")
$call ComicPanCameraAsync("Camera", 1)

$ComicOpenSpawnPanel(0, 1)
$call ComicNextButton()
$ComicOpenSpawnPanel(1, 0.5)
$call ComicNextButton()
$ComicOpenSpawnPanel(2, 0.5)
$call ComicNextButton()
$ComicOpenSpawnPanel(3, 0.5)
$call ComicNextButton()
$call ComicPreloadNextPage()
$ComicOpenSpawnPanel(4, 0.5)
$call ComicNextButton()

// page 5

$call ComicOpenNextPage()
$call ComicSnapCamera("Camera")

$ComicOpenSpawnPanel(0, 0.5)
$call ComicNextButton()

$call ComicUnloadPreviousPage()

$ComicOpenSpawnPanel(1, 0.5)
$call ComicNextButton()
$ComicOpenSpawnPanel(2, 0.5)
$call ComicNextButton()
$ComicOpenSpawnPanel(3, 0.5)
$ComicOpenSpawnPanel(4, 0.5)
$call ComicNextButton()

$call ComicPreloadNextPage()

$ComicOpenSpawnPanel(5, 0.5)
$call ComicNextButton()

// page 6

$call ComicOpenNextPage()
$call ComicSnapCamera("Camera")

$ComicOpenSpawnPanel(0, 0.5)
$call ComicNextButton()

$call ComicUnloadPreviousPage()

$ComicOpenSpawnPanel(1, 0.5)
$call ComicNextButton()
$ComicOpenSpawnPanel(2, 0.5)
$call ComicNextButton()
$ComicOpenSpawnPanel(3, 0.5)
$ComicOpenSpawnPanel(4, 0.5)
$call ComicNextButton()

$call ComicPreloadNextPage()

$ComicOpenSpawnPanel(5, 0.5)
$call ComicNextButton()

// page 7

$call ComicOpenNextPage()
$call ComicPanCameraAsync("Camera", 0.5)

$ComicOpenSpawnPanel(0, 0.5)
$call ComicNextButton()

$call ComicUnloadPreviousPage()

$ComicOpenSpawnPanel(1, 0.5)
$call ComicNextButton()

$ComicOpenSpawnPanel(2, 0.5)
$call ComicNextButton()

$ComicOpenSpawnPanel(3, 0.5)
$ComicOpenSpawnPanel(4, 0.5)
$call ComicNextButton()

$ComicOpenSpawnPanel(5, 0.5)
$call ComicNextButton()