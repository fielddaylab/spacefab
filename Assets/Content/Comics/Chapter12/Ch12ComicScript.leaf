# basePath  Ch12.Comic

#macro	ComicOpenSpawnPanel(panelIndex, waitDuration) \
	$call ComicSetPanelIndex($panelIndex) \
	$call ComicSpawnMask() \
	$call ComicSpawnLayerIndex(0) \
	$wait $waitDuration

:: Preload
@function   ComicPreload
$call ComicPreloadPage(0)
$call ComicSnapCamera("Camera")
$call MusicPreload("Comic.Music.Serious")

:: Execute
@trigger    ComicExecute
@cutscene

// page 1

$call MusicLoop("Comic.Music.Serious")
$call ComicOpenPage(0)

$call ComicPreloadNextPage()
$ComicOpenSpawnPanel(0, 0.5)
$call ComicNextButton()

$ComicOpenSpawnPanel(1, 0.5)
$call ComicNextButton()

$ComicOpenSpawnPanel(2, 1)
$ComicOpenSpawnPanel(3, 1)
$call ComicNextButton()

$ComicOpenSpawnPanel(4, 1)
$call ComicNextButton()

$ComicOpenSpawnPanel(5, 1)
$call ComicNextButton()